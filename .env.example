# --- LINE ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LLM ---
# Either AI_GATEWAY_API_KEY (recommended) or GEMINI_API_KEY (direct).
# When deployed on Vercel, AI Gateway uses OIDC automatically; key is optional.
AI_GATEWAY_API_KEY=
GEMINI_API_KEY=
# Free-tier Gemini key (optional; from a GCP project with no billing account).
GEMINI_API_KEY_FREE=

# --- Google OAuth (for Gmail + Calendar tools) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lekha.vercel.app/api/oauth/google/callback

# --- Upstash Redis (auto-injected by Vercel Marketplace) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace injects KV_* variants instead of UPSTASH_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Upstash Vector (semantic archive + document search; optional but recommended) ---
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Upstash QStash (reminders) ---
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Tavily (web search) ---
TAVILY_API_KEY=

# --- Vercel Blob (fallback receipt-photo storage; optional) ---
# Auto-injected once a Blob store is attached: Vercel dashboard → Storage → Create Database → Blob.
# Used only when a user scans a receipt without Google connected. Free within Hobby limits (no billing risk).
BLOB_READ_WRITE_TOKEN=

# --- Crypto ---
# 64 hex chars (run: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=
# 32-byte hex (run: openssl rand -hex 32)
OAUTH_STATE_SECRET=

# --- LINE Login (web OAuth — separate channel from Messaging API) ---
# Create a LINE Login channel at https://developers.line.biz/console/
# Set Callback URL to: https://lekha-iota.vercel.app/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- LINE Group chat (optional) ---
# The bot's own LINE user ID (used for mention detection and leave detection in groups).
LINE_BOT_USER_ID=
# Comma-separated group/room IDs that are pre-authorised without needing /allowgroup.
ADMIN_GROUP_IDS=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=
STRIPE_TEAM_YEARLY_PRICE_ID=
# Set STRIPE_TEST_MODE=true plus the vars below to use test keys without touching live ones.
STRIPE_TEST_MODE=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_MONTHLY_PRICE_ID=
STRIPE_TEST_YEARLY_PRICE_ID=
STRIPE_TEST_TEAM_MONTHLY_PRICE_ID=
STRIPE_TEST_TEAM_YEARLY_PRICE_ID=

# --- Cron manual trigger ---
# 32-byte hex (run: openssl rand -hex 32)
CRON_MANUAL_SECRET=

# --- App ---
APP_BASE_URL=https://lekha.vercel.app
# Comma-separated LINE user IDs with admin privileges.
ADMIN_LINE_USER_ID=

# --- Dev/test ---
DEV_CHAT_SECRET=

# --- GitHub notify bot (separate LINE channel for push/merge notifications; optional) ---
GITHUB_NOTIFY_CHANNEL_SECRET=
GITHUB_NOTIFY_CHANNEL_ACCESS_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Performance timing logs ---
# Set to 1 to emit structured JSON timing logs at every pipeline step.
# Zero overhead when unset (default).
DEBUG_TIMING=
