# --- LINE ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LLM ---
# Either AI_GATEWAY_API_KEY (recommended) or GEMINI_API_KEY (direct).
# When deployed on Vercel, AI Gateway uses OIDC automatically; key is optional.
AI_GATEWAY_API_KEY=
GEMINI_API_KEY=

# --- Google OAuth (for Gmail + Calendar tools) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lekha.vercel.app/api/oauth/google/callback

# --- Upstash Redis (auto-injected by Vercel Marketplace) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (reminders) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Tavily (web search) ---
TAVILY_API_KEY=

# --- Crypto ---
# 32-byte hex (run: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=
# 32-byte hex (run: openssl rand -hex 32)
OAUTH_STATE_SECRET=

# --- LINE Login (web OAuth — separate channel from Messaging API) ---
# Create a LINE Login channel at https://developers.line.biz/console/
# Set Callback URL to: https://lekha-iota.vercel.app/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cron manual trigger ---
# 32-byte hex (run: openssl rand -hex 32)
CRON_MANUAL_SECRET=

# --- App ---
APP_BASE_URL=https://lekha.vercel.app
