{
  "name": "lekha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/chat.integration.test.ts'",
    "test:integration": "vitest run tests/chat.integration.test.ts",
    "test:eval": "vitest run eval/layer1 eval/layer2",
    "test:watch": "vitest --exclude 'tests/chat.integration.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'tests/chat.integration.test.ts'",
    "eval:small": "tsx eval/layer3/run.ts --suite=small",
    "eval:medium": "tsx eval/layer3/run.ts --suite=medium",
    "eval:full": "tsx eval/layer3/run.ts --suite=full",
    "eval:stress": "tsx eval/layer3/run.ts --suite=stress",
    "eval:list": "tsx eval/layer3/run.ts --suite=small --list"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/qstash": "^2.11.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.38.0",
    "@upstash/vector": "^1.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.193",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.3",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    }
  }
}
